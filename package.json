{
  "name": "douyin-ambient-light",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "Cinema style ambient light for the Douyin (douyin.com) web player. Runs fully locally.",
  "author": "Lim728",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lim728/Douyin-Ambient-Light.git"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "icons": "node scripts/gen-icons.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p jsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node tests/e2e/run.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "esbuild": "^0.25.10",
    "eslint": "^9.36.0",
    "globals": "^16.4.0",
    "jsdom": "^27.0.0",
    "playwright-core": "^1.63.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
